<?xml version="1.0"?>
<!--
  Two-wheeled self-balancing chair WITH a rider body (shared-control baseline).
  Frame convention: +x forward, +y left, +z up. Wheel axle is along y.

  Physics of base_link and the wheels is IDENTICAL to tw_balance.urdf (55 kg box, 2 x 5 kg wheels, r = 0.3 m).
  New:
    - "rider" link: the person's upper body, hinged at the hip (rider_joint, axis y = leaning forward / backward).
      The joint is driven like a spring-damper towards a target angle (see BALANCE_BOT_RIDER_CFG, actuator "rider"):
      target = how far the rider wants to lean. Positive angle = leaning forward.
      Mass here is 1 kg on purpose: the event rider_mass_curriculum adds the real rider mass (40-120 kg) and scales
      the inertia with it, so env.rider_mass is the rider's weight.
    - visuals only (no mass, no collision): seat, backrest, footplate, handlebar on base_link; legs, arms, head.
-->
<robot name="balance_bot_rider">

  <material name="body_blue"><color rgba="0.13 0.36 0.69 1.0"/></material>
  <material name="wheel_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="seat_dark"><color rgba="0.15 0.15 0.17 1.0"/></material>
  <material name="metal"><color rgba="0.55 0.57 0.6 1.0"/></material>
  <material name="shirt"><color rgba="0.85 0.40 0.12 1.0"/></material>
  <material name="trousers"><color rgba="0.25 0.28 0.35 1.0"/></material>
  <material name="skin"><color rgba="0.94 0.71 0.55 1.0"/></material>

  <!-- Chair body -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.45 0.45 0.75"/></geometry>
      <material name="body_blue"/>
    </visual>
    <!-- seat cushion -->
    <visual>
      <origin xyz="0 0 0.405" rpy="0 0 0"/>
      <geometry><box size="0.46 0.46 0.06"/></geometry>
      <material name="seat_dark"/>
    </visual>
    <!-- backrest, slightly reclined -->
    <visual>
      <origin xyz="-0.17 0 0.68" rpy="0 -0.12 0"/>
      <geometry><box size="0.05 0.42 0.52"/></geometry>
      <material name="seat_dark"/>
    </visual>
    <!-- footplate -->
    <visual>
      <origin xyz="0.36 0 -0.33" rpy="0 0 0"/>
      <geometry><box size="0.28 0.40 0.03"/></geometry>
      <material name="seat_dark"/>
    </visual>
    <!-- handlebar: post + bar -->
    <visual>
      <origin xyz="0.44 0 0.22" rpy="0 0.10 0"/>
      <geometry><cylinder radius="0.02" length="1.10"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="0.495 0 0.77" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.02" length="0.50"/></geometry>
      <material name="metal"/>
    </visual>
    <!-- rider's legs rest on the chair: thighs and shins (visual only) -->
    <visual>
      <origin xyz="0.18 0.10 0.50" rpy="0 0 0"/>
      <geometry><box size="0.40 0.13 0.13"/></geometry>
      <material name="trousers"/>
    </visual>
    <visual>
      <origin xyz="0.18 -0.10 0.50" rpy="0 0 0"/>
      <geometry><box size="0.40 0.13 0.13"/></geometry>
      <material name="trousers"/>
    </visual>
    <visual>
      <origin xyz="0.34 0.10 0.10" rpy="0 0 0"/>
      <geometry><box size="0.11 0.11 0.84"/></geometry>
      <material name="trousers"/>
    </visual>
    <visual>
      <origin xyz="0.34 -0.10 0.10" rpy="0 0 0"/>
      <geometry><box size="0.11 0.11 0.84"/></geometry>
      <material name="trousers"/>
    </visual>
    <collision>
      <geometry><box size="0.45 0.45 0.75"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="55.0"/>
      <!-- solid box: I = m/12 * (a^2 + b^2) -->
      <inertia ixx="3.506" iyy="3.506" izz="1.856" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Left wheel -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3" length="0.04"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.113" iyy="0.225" izz="0.113" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.305 -0.305" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.0" friction="0.0"/>
    <limit effort="1.0" velocity="50.0"/>
  </joint>

  <!-- Right wheel -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3" length="0.04"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.113" iyy="0.225" izz="0.113" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.305 -0.305" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.0" friction="0.0"/>
    <limit effort="1.0" velocity="50.0"/>
  </joint>

  <!-- Rider: upper body, hinged at the hip. Link frame = hip, directly above the axle: an upright rider does not
       shift the balance point. -->
  <link name="rider">
    <!-- torso -->
    <visual>
      <origin xyz="0 0 0.28" rpy="0 0 0"/>
      <geometry><box size="0.22 0.38 0.52"/></geometry>
      <material name="shirt"/>
    </visual>
    <!-- head -->
    <visual>
      <origin xyz="0.01 0 0.67" rpy="0 0 0"/>
      <geometry><sphere radius="0.11"/></geometry>
      <material name="skin"/>
    </visual>
    <!-- arms reaching for the handlebar -->
    <visual>
      <origin xyz="0.24 0.22 0.40" rpy="0 1.86 0"/>
      <geometry><box size="0.08 0.08 0.52"/></geometry>
      <material name="shirt"/>
    </visual>
    <visual>
      <origin xyz="0.24 -0.22 0.40" rpy="0 1.86 0"/>
      <geometry><box size="0.08 0.08 0.52"/></geometry>
      <material name="shirt"/>
    </visual>
    <inertial>
      <!-- centre of mass 28 cm above the hip; 1 kg box 0.22 x 0.38 x 0.52 (the real mass is added at reset) -->
      <origin xyz="0 0 0.28" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0346" iyy="0.0266" izz="0.0161" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="rider_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rider"/>
    <origin xyz="0 0 0.44" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.0" friction="0.0"/>
    <limit lower="-0.40" upper="0.40" effort="1000.0" velocity="10.0"/>
  </joint>

</robot>

