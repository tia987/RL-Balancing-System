<?xml version="1.0"?>
<!--
  Self-balancing chair shaped after the Genny Zero, with a seated mannequin (rider task).
  Generated by build_rider_model.py (low-poly meshes in meshes/).
  Frame convention: +x forward, +y left, +z up. base_link origin 0.305 m above the wheel axle (as in tw_balance.urdf).

  Physics of base_link and the wheels is IDENTICAL to tw_balance.urdf (55 kg, 2 x 5 kg wheels, r = 0.3 m, track 0.61 m);
  only the base_link collision box changed shape (it never touches flat ground before the tilt termination).
  Rider (1.75 m mannequin, mass fractions after Dempster / Winter 2009):
    rider_legs : pelvis + legs, 46.4 % of the rider mass, fixed to the chair (fixed joint, keep merge_fixed_joints=False)
    rider      : head + trunk + arms, 53.6 % of the rider mass, on the hip joint rider_joint (axis y, + = lean forward)
  Both rider links weigh 1 kg here; the rider_mass event adds the fraction of the rider mass and scales the inertia.
  Seat top 0.64 m above the floor, hip joints 0.09 m above the seat and 0.10 m behind the axle.
-->
<robot name="balance_bot_rider">

  <material name="chassis"><color rgba="0.170 0.180 0.200 1.000"/></material>
  <material name="accent"><color rgba="0.130 0.360 0.690 1.000"/></material>
  <material name="cushion"><color rgba="0.080 0.080 0.090 1.000"/></material>
  <material name="metal"><color rgba="0.620 0.640 0.670 1.000"/></material>
  <material name="rubber"><color rgba="0.060 0.060 0.060 1.000"/></material>
  <material name="tyre"><color rgba="0.070 0.070 0.070 1.000"/></material>
  <material name="hub"><color rgba="0.550 0.570 0.600 1.000"/></material>
  <material name="mannequin"><color rgba="0.870 0.730 0.560 1.000"/></material>
  <material name="joint"><color rgba="0.660 0.500 0.360 1.000"/></material>

  <link name="base_link">
    <visual><geometry><mesh filename="meshes/chair_chassis.obj"/></geometry><material name="chassis"/></visual>
    <visual><geometry><mesh filename="meshes/chair_accent.obj"/></geometry><material name="accent"/></visual>
    <visual><geometry><mesh filename="meshes/chair_cushion.obj"/></geometry><material name="cushion"/></visual>
    <visual><geometry><mesh filename="meshes/chair_metal.obj"/></geometry><material name="metal"/></visual>
    <visual><geometry><mesh filename="meshes/chair_rubber.obj"/></geometry><material name="rubber"/></visual>
    <collision>
      <origin xyz="0.000 0 -0.220" rpy="0 0 0"/>
      <geometry><box size="0.46 0.44 0.51"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="55.0"/>
      <inertia ixx="3.506" iyy="3.506" izz="1.856" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="left_wheel">
    <visual><geometry><mesh filename="meshes/wheel_tyre.obj"/></geometry><material name="tyre"/></visual>
    <visual><geometry><mesh filename="meshes/wheel_hub.obj"/></geometry><material name="hub"/></visual>
    <visual><geometry><mesh filename="meshes/wheel_chassis.obj"/></geometry><material name="chassis"/></visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.113" iyy="0.225" izz="0.113" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.305 -0.305" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.0" friction="0.0"/>
    <limit effort="1.0" velocity="50.0"/>
  </joint>

  <link name="right_wheel">
    <visual><geometry><mesh filename="meshes/wheel_tyre.obj"/></geometry><material name="tyre"/></visual>
    <visual><geometry><mesh filename="meshes/wheel_hub.obj"/></geometry><material name="hub"/></visual>
    <visual><geometry><mesh filename="meshes/wheel_chassis.obj"/></geometry><material name="chassis"/></visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.113" iyy="0.225" izz="0.113" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.305 -0.305" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.0" friction="0.0"/>
    <limit effort="1.0" velocity="50.0"/>
  </joint>

  <!-- pelvis and legs: fixed to the chair. Link frame = hip joint centre. -->
  <link name="rider_legs">
    <visual><geometry><mesh filename="meshes/rider_legs_mannequin.obj"/></geometry><material name="mannequin"/></visual>
    <visual><geometry><mesh filename="meshes/rider_legs_joint.obj"/></geometry><material name="joint"/></visual>
    <inertial>
      <origin xyz="0.1987 0.0000 -0.0823" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.03095" iyy="0.06907" izz="0.05457" ixy="-0.00000" ixz="0.02422" iyz="0.00000"/>
    </inertial>
  </link>

  <joint name="rider_legs_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rider_legs"/>
    <origin xyz="-0.100 0 0.125" rpy="0 0 0"/>
  </joint>

  <!-- head, trunk and arms: lean about the hip joint. Link frame = hip joint centre. -->
  <link name="rider">
    <visual><geometry><mesh filename="meshes/rider_upper_mannequin.obj"/></geometry><material name="mannequin"/></visual>
    <visual><geometry><mesh filename="meshes/rider_upper_joint.obj"/></geometry><material name="joint"/></visual>
    <inertial>
      <origin xyz="0.0208 -0.0000 0.3445" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.04407" iyy="0.04402" izz="0.02256" ixy="0.00000" ixz="0.00435" iyz="0.00000"/>
    </inertial>
  </link>

  <joint name="rider_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rider"/>
    <origin xyz="-0.100 0 0.125" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.0" friction="0.0"/>
    <limit lower="-0.40" upper="0.40" effort="1000.0" velocity="10.0"/>
  </joint>

</robot>
