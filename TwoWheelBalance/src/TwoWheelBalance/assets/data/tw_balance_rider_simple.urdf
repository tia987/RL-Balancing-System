<?xml version="1.0"?>
<!--
  Self-balancing chair shaped after the Genny Zero, with a seated mannequin (rider task).
  Generated by build_rider_model.py (primitive shapes only).
  Frame convention: +x forward, +y left, +z up. base_link origin 0.305 m above the wheel axle (as in tw_balance.urdf).

  Physics of base_link and the wheels is IDENTICAL to tw_balance.urdf (55 kg, 2 x 5 kg wheels, r = 0.3 m, track 0.61 m);
  only the base_link collision box changed shape (it never touches flat ground before the tilt termination).
  Rider (1.75 m mannequin, mass fractions after Dempster / Winter 2009):
    rider_legs : pelvis + legs, 46.4 % of the rider mass, fixed to the chair (fixed joint, keep merge_fixed_joints=False)
    rider      : head + trunk + arms, 53.6 % of the rider mass, on the hip joint rider_joint (axis y, + = lean forward)
  Both rider links weigh 1 kg here; the rider_mass event adds the fraction of the rider mass and scales the inertia.
  Seat top 0.64 m above the floor, hip joints 0.09 m above the seat and 0.10 m behind the axle.
-->
<robot name="balance_bot_rider">

  <material name="chassis"><color rgba="0.170 0.180 0.200 1.000"/></material>
  <material name="accent"><color rgba="0.130 0.360 0.690 1.000"/></material>
  <material name="cushion"><color rgba="0.080 0.080 0.090 1.000"/></material>
  <material name="metal"><color rgba="0.620 0.640 0.670 1.000"/></material>
  <material name="rubber"><color rgba="0.060 0.060 0.060 1.000"/></material>
  <material name="tyre"><color rgba="0.070 0.070 0.070 1.000"/></material>
  <material name="hub"><color rgba="0.550 0.570 0.600 1.000"/></material>
  <material name="mannequin"><color rgba="0.870 0.730 0.560 1.000"/></material>
  <material name="joint"><color rgba="0.660 0.500 0.360 1.000"/></material>

  <link name="base_link">
    <visual><origin xyz="0.000 0.000 -0.285" rpy="0.000 0.000 0.000"/><geometry><box size="0.400 0.440 0.380"/></geometry><material name="chassis"/></visual>
    <visual><origin xyz="0.000 0.228 -0.285" rpy="0.000 0.000 0.000"/><geometry><box size="0.340 0.020 0.300"/></geometry><material name="accent"/></visual>
    <visual><origin xyz="0.000 -0.228 -0.285" rpy="0.000 0.000 0.000"/><geometry><box size="0.340 0.020 0.300"/></geometry><material name="accent"/></visual>
    <visual><origin xyz="-0.010 0.000 -0.070" rpy="0.000 0.000 0.000"/><geometry><box size="0.220 0.240 0.080"/></geometry><material name="chassis"/></visual>
    <visual><origin xyz="0.000 0.000 -0.027" rpy="0.000 0.000 0.000"/><geometry><box size="0.480 0.480 0.045"/></geometry><material name="chassis"/></visual>
    <visual><origin xyz="0.000 0.000 0.007" rpy="0.000 0.000 0.000"/><geometry><box size="0.440 0.460 0.056"/></geometry><material name="cushion"/></visual>
    <visual><origin xyz="-0.255 0.000 0.335" rpy="0.000 -0.105 0.000"/><geometry><box size="0.050 0.400 0.440"/></geometry><material name="cushion"/></visual>
    <visual><origin xyz="0.265 0.000 0.030" rpy="-0.000 0.416 0"/><geometry><cylinder radius="0.021" length="0.470"/></geometry><material name="metal"/></visual>
    <visual><origin xyz="0.365 0.000 0.280" rpy="0.000 0.000 0.000"/><geometry><box size="0.070 0.130 0.050"/></geometry><material name="chassis"/></visual>
    <visual><origin xyz="0.370 0.000 0.280" rpy="-1.571 0.000 0"/><geometry><cylinder radius="0.016" length="0.300"/></geometry><material name="metal"/></visual>
    <visual><origin xyz="0.370 0.208 0.280" rpy="-1.571 0.000 0"/><geometry><cylinder radius="0.021" length="0.115"/></geometry><material name="rubber"/></visual>
    <visual><origin xyz="0.015 0.250 0.095" rpy="-0.000 1.571 0"/><geometry><cylinder radius="0.012" length="0.230"/></geometry><material name="metal"/></visual>
    <visual><origin xyz="0.370 -0.208 0.280" rpy="1.571 0.000 0"/><geometry><cylinder radius="0.021" length="0.115"/></geometry><material name="rubber"/></visual>
    <visual><origin xyz="0.015 -0.250 0.095" rpy="-0.000 1.571 0"/><geometry><cylinder radius="0.012" length="0.230"/></geometry><material name="metal"/></visual>
    <visual><origin xyz="0.420 0.000 -0.421" rpy="0.000 0.000 0.000"/><geometry><box size="0.240 0.340 0.032"/></geometry><material name="chassis"/></visual>
    <visual><origin xyz="0.250 0.000 -0.385" rpy="-0.000 2.032 0"/><geometry><cylinder radius="0.022" length="0.179"/></geometry><material name="metal"/></visual>
    <collision>
      <origin xyz="0.000 0 -0.220" rpy="0 0 0"/>
      <geometry><box size="0.46 0.44 0.51"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="55.0"/>
      <inertia ixx="3.506" iyy="3.506" izz="1.856" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="left_wheel">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.3" length="0.07"/></geometry><material name="tyre"/></visual>
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.212" length="0.075"/></geometry><material name="hub"/></visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.113" iyy="0.225" izz="0.113" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.305 -0.305" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.0" friction="0.0"/>
    <limit effort="1.0" velocity="50.0"/>
  </joint>

  <link name="right_wheel">
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.3" length="0.07"/></geometry><material name="tyre"/></visual>
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.212" length="0.075"/></geometry><material name="hub"/></visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.3" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.113" iyy="0.225" izz="0.113" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.305 -0.305" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.0" friction="0.0"/>
    <limit effort="1.0" velocity="50.0"/>
  </joint>

  <!-- pelvis and legs: fixed to the chair. Link frame = hip joint centre. -->
  <link name="rider_legs">
    <visual><origin xyz="-0.020 0.000 0.020"/><geometry><sphere radius="0.120"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="0.214 0.090 -0.019" rpy="-0.000 1.658 0"/><geometry><cylinder radius="0.068" length="0.429"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="0.000 0.090 0.000"/><geometry><sphere radius="0.080"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.427 0.090 -0.037"/><geometry><sphere radius="0.056"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.464 0.095 -0.249" rpy="-0.023 2.967 0"/><geometry><cylinder radius="0.043" length="0.431"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="0.427 0.090 -0.037"/><geometry><sphere radius="0.050"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.502 0.100 -0.461"/><geometry><sphere radius="0.035"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.577 0.100 -0.496" rpy="0.000 0.000 0.000"/><geometry><box size="0.250 0.090 0.070"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="0.214 -0.090 -0.019" rpy="-0.000 1.658 0"/><geometry><cylinder radius="0.068" length="0.429"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="0.000 -0.090 0.000"/><geometry><sphere radius="0.080"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.427 -0.090 -0.037"/><geometry><sphere radius="0.056"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.464 -0.095 -0.249" rpy="0.023 2.967 0"/><geometry><cylinder radius="0.043" length="0.431"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="0.427 -0.090 -0.037"/><geometry><sphere radius="0.050"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.502 -0.100 -0.461"/><geometry><sphere radius="0.035"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.577 -0.100 -0.496" rpy="0.000 0.000 0.000"/><geometry><box size="0.250 0.090 0.070"/></geometry><material name="mannequin"/></visual>
    <inertial>
      <origin xyz="0.1987 0.0000 -0.0823" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.03095" iyy="0.06907" izz="0.05457" ixy="-0.00000" ixz="0.02422" iyz="0.00000"/>
    </inertial>
  </link>

  <joint name="rider_legs_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rider_legs"/>
    <origin xyz="-0.100 0 0.125" rpy="0 0 0"/>
  </joint>

  <!-- head, trunk and arms: lean about the hip joint. Link frame = hip joint centre. -->
  <link name="rider">
    <visual><origin xyz="-0.018 0.000 0.285" rpy="-0.000 -0.014 0"/><geometry><cylinder radius="0.130" length="0.370"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="-0.017 0.000 0.557" rpy="-0.000 0.214 0"/><geometry><cylinder radius="0.048" length="0.118"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="0.005 0.000 0.695"/><geometry><sphere radius="0.105"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="0.058 0.198 0.328" rpy="-0.077 2.568 0"/><geometry><cylinder radius="0.044" length="0.326"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="-0.030 0.185 0.465"/><geometry><sphere radius="0.050"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.147 0.210 0.192"/><geometry><sphere radius="0.038"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.274 0.205 0.177" rpy="0.039 1.683 0"/><geometry><cylinder radius="0.033" length="0.256"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="0.147 0.210 0.192"/><geometry><sphere radius="0.036"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.400 0.200 0.163"/><geometry><sphere radius="0.029"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.460 0.198 0.156"/><geometry><sphere radius="0.040"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="0.058 -0.198 0.328" rpy="0.077 2.568 0"/><geometry><cylinder radius="0.044" length="0.326"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="-0.030 -0.185 0.465"/><geometry><sphere radius="0.050"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.147 -0.210 0.192"/><geometry><sphere radius="0.038"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.274 -0.205 0.177" rpy="-0.039 1.683 0"/><geometry><cylinder radius="0.033" length="0.256"/></geometry><material name="mannequin"/></visual>
    <visual><origin xyz="0.147 -0.210 0.192"/><geometry><sphere radius="0.036"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.400 -0.200 0.163"/><geometry><sphere radius="0.029"/></geometry><material name="joint"/></visual>
    <visual><origin xyz="0.460 -0.198 0.156"/><geometry><sphere radius="0.040"/></geometry><material name="mannequin"/></visual>
    <inertial>
      <origin xyz="0.0208 -0.0000 0.3445" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.04407" iyy="0.04402" izz="0.02256" ixy="0.00000" ixz="0.00435" iyz="0.00000"/>
    </inertial>
  </link>

  <joint name="rider_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rider"/>
    <origin xyz="-0.100 0 0.125" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.0" friction="0.0"/>
    <limit lower="-0.40" upper="0.40" effort="1000.0" velocity="10.0"/>
  </joint>

</robot>
